*.Rout
.Rhistory

# Generated analysis output
results/

# macOS
.DS_Store

# Apptainer/Singularity image and build scratch, built by `just build`
*.sif
.apptainer-tmp/
.apptainer-cache/

# Docker image tarball for transfer to HPC (docker save)
*.tar
