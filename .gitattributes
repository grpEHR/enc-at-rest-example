# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must be LF in the working tree, including on Windows:
# a CRLF shebang line makes bash fail with "bad interpreter"
*.sh       text eol=lf
job.slurm  text eol=lf
justfile   text eol=lf

# Encrypted data must round-trip byte-exactly: never apply LF normalization
cipher/** binary
